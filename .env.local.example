# Local dev config. Set NEXT_PUBLIC_GOOGLE_CLIENT_ID to the OAuth web client ID
# the API verifies against (its GOOGLE_OAUTH_CLIENT_ID).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_API_SOCKET_URL=http://localhost:8080
# --- Voice (WebRTC P2P mesh) ---
# Leave off until the API ships the webrtc:* signaling relay; the mic is still
# used locally for speaking indicators.
NEXT_PUBLIC_VOICE_MESH=false

NEXT_PUBLIC_GOOGLE_CLIENT_ID=
