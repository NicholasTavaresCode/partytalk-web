# Copy to .env.local and fill in the Firebase web config for project "partytalk-hml".
# (Firebase console → Project settings → General → Your apps → Web app → SDK setup/config)

# --- PartyTalk API (already running on :3000) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
# Socket.IO connects to this origin, namespace "/rooms"
NEXT_PUBLIC_API_SOCKET_URL=http://localhost:3000

# --- Firebase web config (Google sign-in) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=partytalk-hml.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=partytalk-hml
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=partytalk-hml.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
