# Copy to .env.local and fill in the values below.

# --- PartyTalk API (already running on :3000) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
# Socket.IO connects to this origin, namespace "/rooms"
NEXT_PUBLIC_API_SOCKET_URL=http://localhost:3000

# --- Google sign-in (Google Identity Services) ---
# OAuth 2.0 "Web application" client ID from Google Cloud console
# (APIs & Services → Credentials). Add http://localhost:3001 to the client's
# "Authorized JavaScript origins". The frontend sends the resulting Google ID
# token to the API as `Authorization: Bearer <id_token>`.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
